{
	"name": "oridomi",
	"description": "Origami for the web. Fold up the DOM like paper.",
	"author": "Dan Motzenbecker <dan@oxism.com> (https://oxism.com)",
	"homepage": "https://oxism.com/oriDomi",
	"version": "2.0.0",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"./dist/oridomi.css"
	],
	"engines": {
		"node": ">=22"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/dmotz/oriDomi.git"
	},
	"main": "./dist/oridomi.js",
	"module": "./dist/oridomi.js",
	"types": "./dist/oridomi.d.ts",
	"exports": {
		".": {
			"import": "./dist/oridomi.js",
			"types": "./dist/oridomi.d.ts"
		},
		"./oridomi.css": "./dist/oridomi.css",
		"./react": {
			"import": "./dist/react.js",
			"types": "./dist/react.d.ts"
		},
		"./vue": {
			"import": "./dist/vue.js",
			"types": "./dist/vue.d.ts"
		},
		"./svelte": {
			"import": "./dist/svelte.js",
			"types": "./dist/svelte.d.ts"
		},
		"./solid": {
			"import": "./dist/solid.js",
			"types": "./dist/solid.d.ts"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"keywords": [
		"origami",
		"DOM",
		"paper",
		"folding",
		"frontend",
		"css",
		"transform",
		"3d"
	],
	"devDependencies": {
		"@biomejs/biome": "2.4.11",
		"@playwright/test": "^1.59.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"happy-dom": "^20.8.9",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"serve": "^14.2.6",
		"solid-js": "^1.9.13",
		"svelte": "^5.56.2",
		"tsup": "^8.5.1",
		"typescript": "^6.0.2",
		"vitest": "^4.1.4",
		"vue": "^3.5.35"
	},
	"bugs": {
		"url": "https://github.com/dmotz/oriDomi/issues"
	},
	"scripts": {
		"build": "tsup && node scripts/write-css.mjs",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
		"test": "vitest run && npm run test:e2e",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"pretest:e2e": "npm run build",
		"test:e2e": "playwright test",
		"test:e2e:ui": "npm run test:e2e -- --ui",
		"test:update-snapshots": "npm run test:e2e -- --update-snapshots",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"effection": "^4.0.2"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18",
		"solid-js": ">=1",
		"svelte": ">=4",
		"vue": ">=3"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"solid-js": {
			"optional": true
		},
		"svelte": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	}
}
