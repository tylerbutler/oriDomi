{
  "name": "oridomi",
  "description": "Origami for the web. Fold up the DOM like paper.",
  "author": "Dan Motzenbecker <dan@oxism.com> (https://oxism.com)",
  "homepage": "https://oxism.com/oriDomi",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git://github.com/dmotz/oriDomi.git"
  },
  "main": "./dist/oridomi.js",
  "module": "./dist/oridomi.js",
  "types": "./dist/oridomi.d.ts",
  "exports": {
    ".": {
      "import": "./dist/oridomi.js",
      "types": "./dist/oridomi.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "origami",
    "DOM",
    "paper",
    "folding",
    "frontend",
    "css",
    "transform",
    "3d"
  ],
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "serve": "^14.2.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  },
  "bugs": {
    "url": "https://github.com/dmotz/oriDomi/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:update-snapshots": "npx playwright test --update-snapshots",
    "prepublishOnly": "npm run build"
  }
}
